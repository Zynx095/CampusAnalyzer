# Optional remote MuAPI provider
MU_API_KEY=
API_SUFFIX=https://api.muapi.ai

# Default local generation provider
GENERATION_PROVIDER=comfyui

# Local ComfyUI server
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Relative to server/
COMFYUI_WORKFLOW_PATH=app/workflows/prana_flux_schnell_api.json

COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=1.0